# Base URL of the IFS Cloud instance (no trailing slash)
IFS_URL=https://your-ifs-cloud.example.com
# IAM realm/system name. The issuer becomes ${IFS_URL}/auth/realms/${IFS_REALM}
IFS_REALM=your-system-id
# Optional: override the issuer if your IAM is not served under ${IFS_URL}/auth
# IFS_ISSUER=

# IAM client registered in IFS Cloud for this app
IFS_CLIENT_ID=MAHARA_PKCE_POC
# Leave empty for a public client (recommended for PKCE). Set only if the IAM client is confidential.
IFS_CLIENT_SECRET=
IFS_SCOPE=openid microprofile-jwt

PORT=3000
# Must be registered exactly as a redirect URI on the IAM client
REDIRECT_URI=http://localhost:3000/callback
POST_LOGOUT_REDIRECT_URI=http://localhost:3000/

# Prefilled path for the "Call an IFS API" box, relative to IFS_URL
API_PROBE_PATH=/main/ifsapplications/projection/v1/CustomerHandling.svc/CustomerInfoSet?$top=1

# Optional fixed cookie-signing secret (random per start if empty)
SESSION_SECRET=
