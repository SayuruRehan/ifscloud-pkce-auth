{
  "name": "ifscloud-pkce-auth",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal web app that signs a user in to IFS Cloud IAM with Authorization Code + PKCE",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "jose": "^6.0.11"
  }
}
